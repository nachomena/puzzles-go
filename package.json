{
  "name": "puzzles-go",
  "private": true,
  "type": "module",
  "description": "Juegos de lógica como web app instalable. Sin paso de compilación: ES modules nativos.",
  "scripts": {
    "start": "python3 -m http.server 8000",
    "prepare": "git config core.hooksPath .githooks || true",
    "test": "node --test tests/*.test.js",
    "test:e2e": "playwright test",
    "check": "node scripts/check-js.mjs && node scripts/build-sw.mjs --check",
    "check:js": "node scripts/check-js.mjs",
    "check:sw": "node scripts/build-sw.mjs --check",
    "build:sw": "node scripts/build-sw.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1"
  }
}
