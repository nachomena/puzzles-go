{
  "name": "puzzles-go",
  "private": true,
  "type": "module",
  "description": "Logic puzzles as an installable web app. No build step: native ES modules.",
  "scripts": {
    "start": "python3 -m http.server 8000",
    "prepare": "git config core.hooksPath .githooks || true",
    "test": "node --test tests/*.test.js",
    "test:e2e": "playwright test",
    "check": "node scripts/check-js.mjs && eslint . && node scripts/build-sw.mjs --check",
    "lint": "eslint .",
    "check:js": "node scripts/check-js.mjs",
    "check:sw": "node scripts/build-sw.mjs --check",
    "build:sw": "node scripts/build-sw.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.56.1",
    "eslint": "10.13.0",
    "globals": "17.13.0"
  }
}
